---
import { marked } from 'marked';
import { type ContactFormSection } from 'types';
import Section from '@components/Section.astro';

interface Props extends ContactFormSection {}

const { heading, body, services, submitLabel = 'Ajánlatkérés küldése', ...rest } = Astro.props;
---

<Section {...rest}>
    <div class="max-w-xl mx-auto bg-white p-8 rounded-xl shadow-lg border border-gray-100">
        {heading && <h3 class="text-2xl font-bold text-gray-800 mb-2 text-center">{heading}</h3>}
        {body && <div class="mb-6 text-center max-w-prose mx-auto markdown" set:html={marked.parse(body)} />}

        <form action="https://api.web3forms.com/submit" method="POST" class="space-y-4">
            <input type="hidden" name="access_key" value="A_TE_KULCSOD_JON_IDE" />

            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

            <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Név</label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    placeholder="Pl.: Kovács Péter"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors"
                />
            </div>

            <div>
                <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Telefonszám</label>
                <input
                    type="tel"
                    id="phone"
                    name="phone"
                    required
                    placeholder="Pl.: +36 30 123 4567"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors"
                />
            </div>

            {
                services && services.length > 0 && (
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Milyen munkában segíthetünk? (több is választható)</label>
                        <div class="space-y-2">
                            {services.map((s) => (
                                <label class="flex items-center gap-2 cursor-pointer">
                                    <input type="checkbox" name="service" value={s} class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                                    <span class="text-sm text-gray-700">{s}</span>
                                </label>
                            ))}
                        </div>
                    </div>
                )
            }

            <div>
                <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Hiba vagy feladat rövid leírása</label>
                <textarea
                    id="message"
                    name="message"
                    rows="4"
                    required
                    placeholder="Kérem írja le röviden a problémát..."
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors resize-none"
                ></textarea>
            </div>

            <button
                type="submit"
                class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors duration-300 flex justify-center items-center gap-2"
            >
                {submitLabel}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path
                        fill-rule="evenodd"
                        d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                        clip-rule="evenodd"></path>
                </svg>
            </button>
        </form>
    </div>
</Section>
