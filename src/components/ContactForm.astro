---
import { marked } from 'marked';
import { type ContactFormSection } from 'types';
import Section from '@components/Section.astro';

interface Props extends ContactFormSection {}

const { heading, body, services, submitLabel = 'Ajánlatkérés küldése', ...rest } = Astro.props;
---

<Section {...rest}>
    <div class="flex flex-col lg:flex-row gap-10 lg:gap-16 items-stretch justify-center w-full">
        <div id="contact-form" class="flex-1 w-full lg:max-w-xl bg-white p-8 rounded-xl shadow-2xl border border-gray-100 lg:mx-0">
            {heading && <h3 class="text-3xl font-extrabold text-gray-800 mb-4 text-center tracking-tight">{heading}</h3>}
            {body && <div class="mb-8 text-center max-w-prose mx-auto markdown text-gray-600" set:html={marked.parse(body)} />}

            <form method="POST" class="space-y-5" netlify-honeypot="botcheck" data-netlify="true">
                <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

                <div>
                    <label for="name" class="block text-sm font-semibold text-gray-700 mb-1">Név</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        required
                        placeholder="Pl.: Kovács Péter"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors bg-gray-50 hover:bg-gray-100"
                    />
                </div>

                <div>
                    <label for="phone" class="block text-sm font-semibold text-gray-700 mb-1">Telefonszám</label>
                    <input
                        type="tel"
                        id="phone"
                        name="phone"
                        required
                        placeholder="Pl.: +36 30 123 4567"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors bg-gray-50 hover:bg-gray-100"
                    />
                </div>

                {
                    services && services.length > 0 && (
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Milyen munkában segíthetünk? <span class="font-normal">(több is választható)</span>
                            </label>
                            <div class="flex flex-wrap gap-3">
                                {services.map((s) => (
                                    <label class="flex items-center gap-2 cursor-pointer bg-gray-100 px-3 py-1 rounded-lg hover:bg-blue-50 transition-colors">
                                        <input
                                            type="checkbox"
                                            name="service"
                                            value={s}
                                            class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500"
                                        />
                                        <span class="text-sm text-gray-700">{s}</span>
                                    </label>
                                ))}
                            </div>
                        </div>
                    )
                }

                <div>
                    <label for="message" class="block text-sm font-semibold text-gray-700 mb-1">Hiba vagy feladat rövid leírása</label>
                    <textarea
                        id="message"
                        name="message"
                        rows="4"
                        required
                        placeholder="Kérem írja le röviden a problémát..."
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors resize-none bg-gray-50 hover:bg-gray-100"
                    ></textarea>
                </div>

                <div>
                    <label for="attachment" class="block text-sm font-semibold text-gray-700 mb-1"
                        >Fotó vagy dokumentum a feladathoz <span class="font-normal">(Opcionális)</span></label
                    >
                    <input
                        type="file"
                        id="attachment"
                        name="attachment"
                        accept="image/*, application/pdf, .doc, .docx"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-colors bg-white file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100"
                    />
                    <p class="text-xs text-gray-500 mt-1">Feltölthet képet, vagy csatolhat PDF, Word dokumentumot.</p>
                </div>

                <button
                    type="submit"
                    class="w-full bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white font-semibold py-3 px-6 rounded-lg transition-all duration-300 flex justify-center items-center gap-2 shadow-md hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-blue-400"
                >
                    {submitLabel}
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path
                            fill-rule="evenodd"
                            d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                            clip-rule="evenodd"></path>
                    </svg>
                </button>
            </form>
        </div>

        <div class="flex-1 w-full lg:max-w-xl bg-white p-8 rounded-xl shadow-2xl border border-gray-100 lg:mx-0">
            <!-- telefon -->
            <h3 class="text-3xl font-extrabold text-gray-800 mb-4 text-center tracking-tight">Hívjon minket!</h3>
            <div class="flex items-center gap-4 justify-center p-5">
                <a href="tel:+36301234567" class="text-blue-600 hover:underline font-semibold ml-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-telephone" viewBox="0 0 16 16">
                        <path
                            d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58zM1.884.511a1.745 1.745 0 0 1 2.612.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.68.68 0 0 0 .178.643l2.457 2.457a.68.68 0 0 0 .644.178l2.189-.547a1.75 1.75 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.6 18.6 0 0 1-7.01-4.42 18.6 18.6 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877z"
                        ></path>
                    </svg>
                </a>
                <a href="tel:+36301234567" class="text-lg lg:text-3xl text-blue-600 hover:underline font-semibold ml-1"> +36 30 123 4567 </a>
            </div>
            <!-- email -->
            <hr />
            <h3 class="text-3xl font-extrabold text-gray-800 mb-4 text-center tracking-tight p-5">Írjon nekünk emailt!</h3>
            <div class="flex items-center gap-4 justify-center p-5">
                <a href="mailto:info@example.com" class="text-blue-600 hover:underline font-semibold ml-1">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="h-10 w-10 bi bi-envelope" viewBox="0 0 16 16">
                        <path
                            d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"
                        ></path>
                    </svg>
                </a>
                <a href="mailto:info@example.com" class="text-lg lg:text-3xl text-blue-600 hover:underline font-semibold ml-1"> info@example.com </a>
            </div>
            <!-- social -->
            <hr />
            <h3 class="text-3xl font-extrabold text-gray-800 mb-4 text-center tracking-tight p-5">
                Vegye fel velünk a kapcsolatot a közösségi médián keresztül!
            </h3>
            <div class="flex items-center gap-4 justify-center">
                <a href="https://www.facebook.com" class="text-blue-600 hover:underline font-semibold ml-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="currentColor" viewBox="0 0 24 24"
                        ><path
                            d="M22.675 0h-21.35C.595 0 0 .592 0 1.326v21.348C0 23.408.595 24 1.325 24h11.495v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.797.143v3.24l-1.918.001c-1.504 0-1.797.715-1.797 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116C23.406 24 24 23.408 24 22.674V1.326C24 .592 23.406 0 22.675 0"
                        ></path></svg
                    >
                </a>
                <a
                    href="https://www.facebook.com"
                    class="text-lg lg:text-3xl text-blue-600 hover:underline font-semibold ml-1"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Facebook</a
                >
            </div>
        </div>
    </div>
</Section>
