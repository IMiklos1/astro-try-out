---
import { marked } from 'marked';
import { type ServiceAreaSection } from 'types';
import Section from '@components/Section.astro';

interface Props extends ServiceAreaSection {}

const { heading, body, subheading, description, cities, ctaText, phoneNumber, phoneLink, mapEmbedUrl, mapTitle, ...rest } = Astro.props;

const telHref = phoneLink ? `tel:${phoneLink}` : undefined;
---

<Section {...rest}>
    <div class="container mx-auto px-2 max-w-6xl">
        <div class="text-center mb-10">
            {heading && <h2 class="text-3xl font-bold text-gray-800 mb-4">{heading}</h2>}
            {body && <div class="text-gray-600 max-w-2xl mx-auto markdown" set:html={marked.parse(body)} />}
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
            <div class="space-y-6">
                {subheading && <h3 class="text-2xl font-semibold text-gray-800">{subheading}</h3>}
                {description && <p class="text-gray-600 leading-relaxed">{description}</p>}

                {
                    cities && cities.length > 0 && (
                        <ul class="grid grid-cols-2 gap-3 text-gray-700 font-medium">
                            {cities.map((city) => (
                                <li class="flex items-center gap-2">
                                    <svg class="w-5 h-5 text-blue-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                    {city}
                                </li>
                            ))}
                        </ul>
                    )
                }

                {
                    (ctaText || phoneNumber) && (
                        <div class="pt-4 border-t border-gray-100">
                            {ctaText && <p class="text-sm text-gray-500 mb-3">{ctaText}</p>}
                            {phoneNumber && telHref && (
                                <a href={telHref} class="inline-flex items-center gap-2 text-blue-600 font-bold hover:text-blue-800 transition-colors">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                        />
                                    </svg>
                                    {phoneNumber}
                                </a>
                            )}
                        </div>
                    )
                }
            </div>

            {
                mapEmbedUrl && (
                    <div class="h-[400px] w-full rounded-xl overflow-hidden shadow-lg border border-gray-200 bg-gray-50">
                        <iframe
                            src={mapEmbedUrl}
                            width="100%"
                            height="100%"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            title={mapTitle || 'Szolgáltatási terület'}
                        />
                    </div>
                )
            }
        </div>
    </div>
</Section>
